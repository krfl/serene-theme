{
  "$schema": "vscode://schemas/color-theme",
  "name": "Serene Day",
  "type": "light",
  "colors": {
    "editor.background": "#f5f2ed",
    "editor.foreground": "#3d3a33",
    "editorLineNumber.foreground": "#b5ad9a",
    "editorLineNumber.activeForeground": "#7a7260",
    "editorCursor.foreground": "#3d3a33",
    "editor.selectionBackground": "#e3d5b8",
    "editor.selectionHighlightBackground": "#e3d5b866",
    "editor.inactiveSelectionBackground": "#ebe6db",
    "editor.lineHighlightBackground": "#ebe6db",
    "editor.lineHighlightBorder": "#00000000",
    "editorWhitespace.foreground": "#b5ad9a",
    "editorIndentGuide.background": "#d4cfc4",
    "editorIndentGuide.activeBackground": "#b5ad9a",
    "editorRuler.foreground": "#d4cfc4",
    "editorWidget.background": "#ebe6db",
    "editorWidget.border": "#d4cfc4",
    "editorSuggestWidget.background": "#ebe6db",
    "editorSuggestWidget.border": "#d4cfc4",
    "editorSuggestWidget.foreground": "#3d3a33",
    "editorSuggestWidget.selectedBackground": "#e3d5b8",
    "editorHoverWidget.background": "#ebe6db",
    "editorHoverWidget.border": "#d4cfc4",
    "peekView.border": "#d4cfc4",
    "peekViewEditor.background": "#f5f2ed",
    "peekViewResult.background": "#ebe6db",
    "peekViewTitle.background": "#d4cfc4",
    "statusBar.background": "#ebe6db",
    "statusBar.foreground": "#6e665a",
    "statusBar.noFolderBackground": "#ebe6db",
    "statusBar.debuggingBackground": "#8b4a38",
    "statusBar.debuggingForeground": "#f5f2ed",
    "activityBar.background": "#f5f2ed",
    "activityBar.foreground": "#3d3a33",
    "activityBar.inactiveForeground": "#b5ad9a",
    "activityBarBadge.background": "#606b44",
    "activityBarBadge.foreground": "#f5f2ed",
    "sideBar.background": "#ebe6db",
    "sideBar.foreground": "#3d3a33",
    "sideBar.border": "#d4cfc4",
    "sideBarTitle.foreground": "#3d3a33",
    "sideBarSectionHeader.background": "#e3d5b8",
    "sideBarSectionHeader.foreground": "#3d3a33",
    "list.activeSelectionBackground": "#e3d5b8",
    "list.activeSelectionForeground": "#3d3a33",
    "list.inactiveSelectionBackground": "#ebe6db",
    "list.hoverBackground": "#e3d5b8",
    "list.focusBackground": "#e3d5b8",
    "list.focusForeground": "#3d3a33",
    "tab.activeBackground": "#f5f2ed",
    "tab.activeForeground": "#3d3a33",
    "tab.inactiveBackground": "#ebe6db",
    "tab.inactiveForeground": "#6e665a",
    "tab.border": "#d4cfc4",
    "tab.activeBorder": "#00000000",
    "tab.activeBorderTop": "#606b44",
    "panel.background": "#f5f2ed",
    "panel.border": "#d4cfc4",
    "panelTitle.activeBorder": "#606b44",
    "panelTitle.activeForeground": "#3d3a33",
    "panelTitle.inactiveForeground": "#6e665a",
    "terminal.background": "#f5f2ed",
    "terminal.foreground": "#3d3a33",
    "terminal.ansiBlack": "#4a4538",
    "terminal.ansiRed": "#8b4a38",
    "terminal.ansiGreen": "#536f44",
    "terminal.ansiYellow": "#875f33",
    "terminal.ansiBlue": "#5c7554",
    "terminal.ansiMagenta": "#7c6340",
    "terminal.ansiCyan": "#6d6555",
    "terminal.ansiWhite": "#7b7568",
    "terminal.ansiBrightBlack": "#35322a",
    "terminal.ansiBrightRed": "#8b4a38",
    "terminal.ansiBrightGreen": "#606b44",
    "terminal.ansiBrightYellow": "#875f33",
    "terminal.ansiBrightBlue": "#5c7554",
    "terminal.ansiBrightMagenta": "#8b6340",
    "terminal.ansiBrightCyan": "#a89984",
    "terminal.ansiBrightWhite": "#f5f2ed",
    "gitDecoration.modifiedResourceForeground": "#875f33",
    "gitDecoration.deletedResourceForeground": "#8b4a38",
    "gitDecoration.untrackedResourceForeground": "#536f44",
    "gitDecoration.ignoredResourceForeground": "#b5ad9a",
    "gitDecoration.conflictingResourceForeground": "#9e523c",
    "notificationCenter.border": "#d4cfc4",
    "notificationCenterHeader.background": "#ebe6db",
    "notifications.background": "#ebe6db",
    "notifications.border": "#d4cfc4",
    "notificationsErrorIcon.foreground": "#8b4a38",
    "notificationsWarningIcon.foreground": "#875f33",
    "notificationsInfoIcon.foreground": "#5c7554",
    "input.background": "#ebe6db",
    "input.border": "#d4cfc4",
    "input.foreground": "#3d3a33",
    "input.placeholderForeground": "#b5ad9a",
    "inputOption.activeBorder": "#606b44",
    "inputValidation.errorBackground": "#8b4a3833",
    "inputValidation.errorBorder": "#8b4a38",
    "inputValidation.warningBackground": "#875f3333",
    "inputValidation.warningBorder": "#875f33",
    "button.background": "#606b44",
    "button.foreground": "#f5f2ed",
    "button.hoverBackground": "#6d6555",
    "scrollbarSlider.background": "#d4cfc466",
    "scrollbarSlider.hoverBackground": "#b5ad9a66",
    "scrollbarSlider.activeBackground": "#6e665a99",
    "badge.background": "#606b44",
    "badge.foreground": "#f5f2ed",
    "progressBar.background": "#606b44",
    "titleBar.activeBackground": "#f5f2ed",
    "titleBar.activeForeground": "#3d3a33",
    "titleBar.inactiveBackground": "#ebe6db",
    "titleBar.inactiveForeground": "#6e665a",
    "titleBar.border": "#d4cfc4",
    "breadcrumb.foreground": "#6e665a",
    "breadcrumb.focusForeground": "#3d3a33",
    "breadcrumb.activeSelectionForeground": "#3d3a33",
    "breadcrumbPicker.background": "#ebe6db",
    "editorError.foreground": "#8b4a38",
    "editorWarning.foreground": "#c68a2e",
    "editorInfo.foreground": "#4a7a68",
    "editorHint.foreground": "#8a826f",
    "diffEditor.insertedTextBackground": "#536f4422",
    "diffEditor.removedTextBackground": "#8b4a3822"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6e665a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#536f44"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#9e523c"
      }
    },
    {
      "name": "Constants",
      "scope": ["constant.language", "constant.character", "constant.other"],
      "settings": {
        "foreground": "#9e523c"
      }
    },
    {
      "name": "Enum Constants",
      "scope": ["constant.other.enum"],
      "settings": {
        "foreground": "#8b4a38"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "keyword.operator.new"],
      "settings": {
        "foreground": "#606b44"
      }
    },
    {
      "name": "Flow Control Keywords",
      "scope": ["keyword.control.return", "keyword.control.flow"],
      "settings": {
        "foreground": "#8b4a38"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#5a5240"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation"],
      "settings": {
        "foreground": "#6a6350"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#606b44"
      }
    },
    {
      "name": "Annotations",
      "scope": ["storage.type.annotation", "punctuation.definition.annotation"],
      "settings": {
        "foreground": "#8b4a38"
      }
    },
    {
      "name": "Namespace",
      "scope": ["entity.name.namespace"],
      "settings": {
        "foreground": "#8b4a38"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#875f33"
      }
    },
    {
      "name": "Class, Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#7c6340"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "support.variable"],
      "settings": {
        "foreground": "#6a6350"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#6a6350"
      }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#6a6350"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#606b44"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#875f33"
      }
    },
    {
      "name": "CSS Pseudo-class",
      "scope": ["entity.other.attribute-name.pseudo-class"],
      "settings": {
        "foreground": "#8b4a38"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#8b4a38"
      }
    },
    {
      "name": "Markup Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#7c6340",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#7c6340",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup Heading",
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#875f33",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Link",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#606b44"
      }
    },
    {
      "name": "Markup Code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#536f44"
      }
    },
    {
      "name": "Markup Quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#6e665a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff Inserted",
      "scope": ["markup.inserted", "diff.inserted"],
      "settings": {
        "foreground": "#536f44"
      }
    },
    {
      "name": "Diff Deleted",
      "scope": ["markup.deleted", "diff.deleted"],
      "settings": {
        "foreground": "#8b4a38"
      }
    },
    {
      "name": "Diff Changed",
      "scope": ["markup.changed", "diff.changed"],
      "settings": {
        "foreground": "#875f33"
      }
    },
    {
      "name": "JSON Key",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#875f33"
      }
    },
    {
      "name": "CSS Class",
      "scope": ["entity.other.attribute-name.class.css"],
      "settings": {
        "foreground": "#7c6340"
      }
    },
    {
      "name": "CSS ID",
      "scope": ["entity.other.attribute-name.id.css"],
      "settings": {
        "foreground": "#875f33"
      }
    },
    {
      "name": "CSS Property",
      "scope": ["support.type.property-name.css"],
      "settings": {
        "foreground": "#6a6350"
      }
    },
    {
      "name": "Constructor",
      "scope": ["entity.name.function.constructor"],
      "settings": {
        "foreground": "#875f33"
      }
    },
    {
      "name": "Markup List",
      "scope": ["markup.list"],
      "settings": {
        "foreground": "#5a5240"
      }
    }
  ]
}
