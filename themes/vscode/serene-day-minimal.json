{
  "$schema": "vscode://schemas/color-theme",
  "name": "Serene Day Minimal",
  "type": "light",
  "colors": {
    "editor.background": "#f5f2ed",
    "editor.foreground": "#3d3a33",
    "editorLineNumber.foreground": "#b5ad9a",
    "editorLineNumber.activeForeground": "#7a7260",
    "editorCursor.foreground": "#3d3a33",
    "editor.selectionBackground": "#e3d5b8",
    "editor.selectionHighlightBackground": "#e3d5b866",
    "editor.inactiveSelectionBackground": "#ebe6db",
    "editor.lineHighlightBackground": "#ebe6db",
    "editor.lineHighlightBorder": "#00000000",
    "editorWhitespace.foreground": "#b5ad9a",
    "editorIndentGuide.background": "#d4cfc4",
    "editorIndentGuide.activeBackground": "#b5ad9a",
    "editorRuler.foreground": "#d4cfc4",
    "editorWidget.background": "#ebe6db",
    "editorWidget.border": "#d4cfc4",
    "editorSuggestWidget.background": "#ebe6db",
    "editorSuggestWidget.border": "#d4cfc4",
    "editorSuggestWidget.foreground": "#3d3a33",
    "editorSuggestWidget.selectedBackground": "#e3d5b8",
    "editorHoverWidget.background": "#ebe6db",
    "editorHoverWidget.border": "#d4cfc4",
    "peekView.border": "#d4cfc4",
    "peekViewEditor.background": "#f5f2ed",
    "peekViewResult.background": "#ebe6db",
    "peekViewTitle.background": "#d4cfc4",
    "statusBar.background": "#ebe6db",
    "statusBar.foreground": "#857d6d",
    "statusBar.noFolderBackground": "#ebe6db",
    "statusBar.debuggingBackground": "#ab5940",
    "statusBar.debuggingForeground": "#f5f2ed",
    "activityBar.background": "#f5f2ed",
    "activityBar.foreground": "#3d3a33",
    "activityBar.inactiveForeground": "#b5ad9a",
    "activityBarBadge.background": "#657047",
    "activityBarBadge.foreground": "#f5f2ed",
    "sideBar.background": "#ebe6db",
    "sideBar.foreground": "#3d3a33",
    "sideBar.border": "#d4cfc4",
    "sideBarTitle.foreground": "#3d3a33",
    "sideBarSectionHeader.background": "#e3d5b8",
    "sideBarSectionHeader.foreground": "#3d3a33",
    "list.activeSelectionBackground": "#e3d5b8",
    "list.activeSelectionForeground": "#3d3a33",
    "list.inactiveSelectionBackground": "#ebe6db",
    "list.hoverBackground": "#e3d5b8",
    "list.focusBackground": "#e3d5b8",
    "list.focusForeground": "#3d3a33",
    "tab.activeBackground": "#f5f2ed",
    "tab.activeForeground": "#3d3a33",
    "tab.inactiveBackground": "#ebe6db",
    "tab.inactiveForeground": "#857d6d",
    "tab.border": "#d4cfc4",
    "tab.activeBorder": "#00000000",
    "tab.activeBorderTop": "#657047",
    "panel.background": "#f5f2ed",
    "panel.border": "#d4cfc4",
    "panelTitle.activeBorder": "#657047",
    "panelTitle.activeForeground": "#3d3a33",
    "panelTitle.inactiveForeground": "#857d6d",
    "terminal.background": "#f5f2ed",
    "terminal.foreground": "#3d3a33",
    "terminal.ansiBlack": "#4a4538",
    "terminal.ansiRed": "#ab5940",
    "terminal.ansiGreen": "#5a7a4a",
    "terminal.ansiYellow": "#9a6c3a",
    "terminal.ansiBlue": "#5c7554",
    "terminal.ansiMagenta": "#8b6f47",
    "terminal.ansiCyan": "#6d6555",
    "terminal.ansiWhite": "#e8e3d8",
    "terminal.ansiBrightBlack": "#3d3a33",
    "terminal.ansiBrightRed": "#ab5940",
    "terminal.ansiBrightGreen": "#657047",
    "terminal.ansiBrightYellow": "#9a6c3a",
    "terminal.ansiBrightBlue": "#5c7554",
    "terminal.ansiBrightMagenta": "#8b6340",
    "terminal.ansiBrightCyan": "#857d6d",
    "terminal.ansiBrightWhite": "#f5f2ed",
    "gitDecoration.modifiedResourceForeground": "#9a6c3a",
    "gitDecoration.deletedResourceForeground": "#ab5940",
    "gitDecoration.untrackedResourceForeground": "#5a7a4a",
    "gitDecoration.ignoredResourceForeground": "#b5ad9a",
    "gitDecoration.conflictingResourceForeground": "#a5563f",
    "notificationCenter.border": "#d4cfc4",
    "notificationCenterHeader.background": "#ebe6db",
    "notifications.background": "#ebe6db",
    "notifications.border": "#d4cfc4",
    "notificationsErrorIcon.foreground": "#ab5940",
    "notificationsWarningIcon.foreground": "#9a6c3a",
    "notificationsInfoIcon.foreground": "#5c7554",
    "input.background": "#ebe6db",
    "input.border": "#d4cfc4",
    "input.foreground": "#3d3a33",
    "input.placeholderForeground": "#b5ad9a",
    "inputOption.activeBorder": "#657047",
    "inputValidation.errorBackground": "#ab594033",
    "inputValidation.errorBorder": "#ab5940",
    "inputValidation.warningBackground": "#9a6c3a33",
    "inputValidation.warningBorder": "#9a6c3a",
    "button.background": "#657047",
    "button.foreground": "#f5f2ed",
    "button.hoverBackground": "#6d6555",
    "scrollbarSlider.background": "#d4cfc466",
    "scrollbarSlider.hoverBackground": "#b5ad9a66",
    "scrollbarSlider.activeBackground": "#857d6d99",
    "badge.background": "#657047",
    "badge.foreground": "#f5f2ed",
    "progressBar.background": "#657047",
    "titleBar.activeBackground": "#f5f2ed",
    "titleBar.activeForeground": "#3d3a33",
    "titleBar.inactiveBackground": "#ebe6db",
    "titleBar.inactiveForeground": "#857d6d",
    "titleBar.border": "#d4cfc4",
    "breadcrumb.foreground": "#857d6d",
    "breadcrumb.focusForeground": "#3d3a33",
    "breadcrumb.activeSelectionForeground": "#3d3a33",
    "breadcrumbPicker.background": "#ebe6db",
    "editorError.foreground": "#ab5940",
    "editorError.background": "#f7ebe6",
    "editorWarning.foreground": "#ab5940",
    "editorWarning.background": "#f7ebe6",
    "editorInfo.foreground": "#ab5940",
    "editorInfo.background": "#f7ebe6",
    "editorHint.foreground": "#ab5940",
    "editorHint.background": "#f7ebe6",
    "diffEditor.insertedTextBackground": "#5a7a4a22",
    "diffEditor.removedTextBackground": "#ab594022"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#857d6d",
        "background": "#ebe8e0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#5a7a4a",
        "background": "#e8ede0"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#a5563f",
        "background": "#f7ead8"
      }
    },
    {
      "name": "Constants",
      "scope": ["constant.language", "constant.character", "constant.other"],
      "settings": {
        "foreground": "#a5563f",
        "background": "#f7ead8"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "keyword.operator.new"],
      "settings": {
        "foreground": "#657047",
        "background": "#edecd4"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#3d3a33"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#657047",
        "background": "#edecd4"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#3d3a33",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Class, Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#3d3a33"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "support.variable"],
      "settings": {
        "foreground": "#3d3a33"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#3d3a33"
      }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#a5563f",
        "background": "#f7ead8"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#657047",
        "background": "#edecd4"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#a5563f",
        "background": "#f7ead8"
      }
    },
    {
      "name": "Punctuation Bracket",
      "scope": ["punctuation.definition.bracket", "meta.brace"],
      "settings": {
        "foreground": "#3d3a33",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Label",
      "scope": ["entity.name.label"],
      "settings": {
        "foreground": "#3d3a33",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#ab5940"
      }
    },
    {
      "name": "Markup Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#3d3a33",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#3d3a33",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup Heading",
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#657047",
        "background": "#edecd4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Link",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#9a6c3a",
        "background": "#e4e8ed"
      }
    },
    {
      "name": "Markup Code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#a5563f",
        "background": "#f7ead8"
      }
    },
    {
      "name": "Markup Quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#9a6c3a",
        "background": "#e4e8ed"
      }
    },
    {
      "name": "Markup List",
      "scope": ["markup.list"],
      "settings": {
        "foreground": "#657047",
        "background": "#edecd4"
      }
    },
    {
      "name": "Diff Inserted",
      "scope": ["markup.inserted", "diff.inserted"],
      "settings": {
        "foreground": "#5a7a4a"
      }
    },
    {
      "name": "Diff Deleted",
      "scope": ["markup.deleted", "diff.deleted"],
      "settings": {
        "foreground": "#ab5940"
      }
    },
    {
      "name": "Diff Changed",
      "scope": ["markup.changed", "diff.changed"],
      "settings": {
        "foreground": "#9a6c3a"
      }
    },
    {
      "name": "JSON Key",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#3d3a33",
        "fontStyle": "bold"
      }
    },
    {
      "name": "CSS Class",
      "scope": ["entity.other.attribute-name.class.css"],
      "settings": {
        "foreground": "#3d3a33"
      }
    },
    {
      "name": "CSS ID",
      "scope": ["entity.other.attribute-name.id.css"],
      "settings": {
        "foreground": "#3d3a33",
        "fontStyle": "bold"
      }
    },
    {
      "name": "CSS Property",
      "scope": ["support.type.property-name.css"],
      "settings": {
        "foreground": "#3d3a33"
      }
    },
    {
      "name": "Namespace",
      "scope": ["entity.name.namespace", "entity.name.module"],
      "settings": {
        "foreground": "#9a6c3a",
        "background": "#e4e8ed"
      }
    },
    {
      "name": "Constructor",
      "scope": ["entity.name.function.constructor"],
      "settings": {
        "foreground": "#3d3a33"
      }
    },
    {
      "name": "Special",
      "scope": ["entity.name.special", "support.constant"],
      "settings": {
        "foreground": "#a5563f",
        "background": "#f7ead8"
      }
    }
  ]
}
